{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Minecraft Server",
      "type": "shell",
      "command": "rm -f run/world/session.lock 2>/dev/null; PID=$(lsof -ti :25565 2>/dev/null); if [ ! -z \"$PID\" ]; then kill -9 $PID 2>/dev/null; sleep 1; fi; ./gradlew runServer",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false,
        "clear": true
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "runOptions": {
        "instanceLimit": 1
      }
    },
    {
      "label": "Build Mod",
      "type": "shell",
      "command": "./gradlew build",
      "problemMatcher": ["$gradle"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "Clean Build",
      "type": "shell",
      "command": "./gradlew clean build",
      "problemMatcher": ["$gradle"],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "Run Client",
      "type": "shell",
      "command": "./gradlew runClient",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "runOptions": {
        "instanceLimit": 1
      }
    }
  ]
}

